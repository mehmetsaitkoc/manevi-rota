{"chapter":86,"verses":[{"verse":1,"text":"وَٱلسَّمَآءِ وَٱلطَّارِقِ"},{"verse":2,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ"},{"verse":3,"text":"ٱلنَّجۡمُ ٱلثَّاقِبُ"},{"verse":4,"text":"إِن كُلُّ نَفۡسࣲ لَّمَّا عَلَيۡهَا حَافِظࣱ‏"},{"verse":5,"text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ"},{"verse":6,"text":"خُلِقَ مِن مَّآءࣲ دَافِقࣲ‏"},{"verse":7,"text":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ"},{"verse":8,"text":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ‏"},{"verse":9,"text":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ"},{"verse":10,"text":"فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ‏"},{"verse":11,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ"},{"verse":12,"text":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ"},{"verse":13,"text":"إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ‏"},{"verse":14,"text":"وَمَا هُوَ بِٱلۡهَزۡلِ"},{"verse":15,"text":"إِنَّهُمۡ يَكِيدُونَ كَيۡدࣰ ا"},{"verse":16,"text":"وَأَكِيدُ كَيۡدࣰ ا"},{"verse":17,"text":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا"}]}