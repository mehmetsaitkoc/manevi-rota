{"chapter":95,"verses":[{"verse":1,"text":"وَٱلتِّينِ وَٱلزَّيۡتُونِ"},{"verse":2,"text":"وَطُورِ سِينِينَ"},{"verse":3,"text":"وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ"},{"verse":4,"text":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمࣲ‏"},{"verse":5,"text":"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ"},{"verse":6,"text":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونࣲ‏"},{"verse":7,"text":"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ"},{"verse":8,"text":"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ"}]}