{"chapter":77,"verses":[{"verse":1,"text":"وَٱلۡمُرۡسَلَٰتِ عُرۡفࣰ ا"},{"verse":2,"text":"فَٱلۡعَٰصِفَٰتِ عَصۡفࣰ ا"},{"verse":3,"text":"وَٱلنَّٰشِرَٰتِ نَشۡرࣰ ا"},{"verse":4,"text":"فَٱلۡفَٰرِقَٰتِ فَرۡقࣰ ا"},{"verse":5,"text":"فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا"},{"verse":6,"text":"عُذۡرًا أَوۡ نُذۡرًا"},{"verse":7,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعࣱ‏"},{"verse":8,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتۡ"},{"verse":9,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ"},{"verse":10,"text":"وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ"},{"verse":11,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ"},{"verse":12,"text":"لِأَيِّ يَوۡمٍ أُجِّلَتۡ"},{"verse":13,"text":"لِيَوۡمِ ٱلۡفَصۡلِ"},{"verse":14,"text":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ"},{"verse":15,"text":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"verse":16,"text":"أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ"},{"verse":17,"text":"ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ"},{"verse":18,"text":"كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ"},{"verse":19,"text":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"verse":20,"text":"أَلَمۡ نَخۡلُقكُّم مِّن مَّآءࣲ مَّهِينࣲ‏"},{"verse":21,"text":"فَجَعَلۡنَٰهُ فِي قَرَارࣲ مَّكِينٍ"},{"verse":22,"text":"إِلَىٰ قَدَرࣲ مَّعۡلُومࣲ‏"},{"verse":23,"text":"فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ"},{"verse":24,"text":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"verse":25,"text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا"},{"verse":26,"text":"أَحۡيَآءࣰ وَأَمۡوَٰتࣰ ا"},{"verse":27,"text":"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتࣲ وَأَسۡقَيۡنَٰكُم مَّآءࣰ فُرَاتࣰ ا"},{"verse":28,"text":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"verse":29,"text":"ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"},{"verse":30,"text":"ٱنطَلِقُوٓاْ إِلَىٰ ظِلࣲّ ذِي ثَلَٰثِ شُعَبࣲ‏"},{"verse":31,"text":"لَّا ظَلِيلࣲ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ"},{"verse":32,"text":"إِنَّهَا تَرۡمِي بِشَرَرࣲ كَٱلۡقَصۡرِ"},{"verse":33,"text":"كَأَنَّهُۥ جِمَٰلَتࣱ صُفۡرࣱ‏"},{"verse":34,"text":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"verse":35,"text":"هَٰذَا يَوۡمُ لَا يَنطِقُونَ"},{"verse":36,"text":"وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ"},{"verse":37,"text":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"verse":38,"text":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ"},{"verse":39,"text":"فَإِن كَانَ لَكُمۡ كَيۡدࣱ فَكِيدُونِ"},{"verse":40,"text":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"verse":41,"text":"إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلࣲ وَعُيُونࣲ‏"},{"verse":42,"text":"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ"},{"verse":43,"text":"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ"},{"verse":44,"text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"},{"verse":45,"text":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"verse":46,"text":"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ"},{"verse":47,"text":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"verse":48,"text":"وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ"},{"verse":49,"text":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"verse":50,"text":"فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ"}]}