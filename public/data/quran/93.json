{"chapter":93,"verses":[{"verse":1,"text":"وَٱلضُّحَىٰ"},{"verse":2,"text":"وَٱلَّيۡلِ إِذَا سَجَىٰ"},{"verse":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"verse":4,"text":"وَلَلۡأٓخِرَةُ خَيۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ"},{"verse":5,"text":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ"},{"verse":6,"text":"أَلَمۡ يَجِدۡكَ يَتِيمࣰ ا فَـَٔاوَىٰ"},{"verse":7,"text":"وَوَجَدَكَ ضَآلࣰّ ا فَهَدَىٰ"},{"verse":8,"text":"وَوَجَدَكَ عَآئِلࣰ ا فَأَغۡنَىٰ"},{"verse":9,"text":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ"},{"verse":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ"},{"verse":11,"text":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ"}]}