{"chapter":84,"verses":[{"verse":1,"text":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ"},{"verse":2,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"},{"verse":3,"text":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ"},{"verse":4,"text":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ"},{"verse":5,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"},{"verse":6,"text":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحࣰ ا فَمُلَٰقِيهِ"},{"verse":7,"text":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ"},{"verse":8,"text":"فَسَوۡفَ يُحَاسَبُ حِسَابࣰ ا يَسِيرࣰ ا"},{"verse":9,"text":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورࣰ ا"},{"verse":10,"text":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ"},{"verse":11,"text":"فَسَوۡفَ يَدۡعُواْ ثُبُورࣰ ا"},{"verse":12,"text":"وَيَصۡلَىٰ سَعِيرًا"},{"verse":13,"text":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا"},{"verse":14,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"},{"verse":15,"text":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرࣰ ا"},{"verse":16,"text":"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ"},{"verse":17,"text":"وَٱلَّيۡلِ وَمَا وَسَقَ"},{"verse":18,"text":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ"},{"verse":19,"text":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقࣲ‏"},{"verse":20,"text":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ"},{"verse":21,"text":"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩"},{"verse":22,"text":"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ"},{"verse":23,"text":"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ"},{"verse":24,"text":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ"},{"verse":25,"text":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ"}]}