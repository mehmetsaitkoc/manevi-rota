{"chapter":88,"verses":[{"verse":1,"text":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ"},{"verse":2,"text":"وُجُوهࣱ يَوۡمَئِذٍ خَٰشِعَةٌ"},{"verse":3,"text":"عَامِلَةࣱ نَّاصِبَةࣱ‏"},{"verse":4,"text":"تَصۡلَىٰ نَارًا حَامِيَةࣰ‏"},{"verse":5,"text":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةࣲ‏"},{"verse":6,"text":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعࣲ‏"},{"verse":7,"text":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعࣲ‏"},{"verse":8,"text":"وُجُوهࣱ يَوۡمَئِذࣲ نَّاعِمَةࣱ‏"},{"verse":9,"text":"لِّسَعۡيِهَا رَاضِيَةࣱ‏"},{"verse":10,"text":"فِي جَنَّةٍ عَالِيَةࣲ‏"},{"verse":11,"text":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةࣰ‏"},{"verse":12,"text":"فِيهَا عَيۡنࣱ جَارِيَةࣱ‏"},{"verse":13,"text":"فِيهَا سُرُرࣱ مَّرۡفُوعَةࣱ‏"},{"verse":14,"text":"وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ‏"},{"verse":15,"text":"وَنَمَارِقُ مَصۡفُوفَةࣱ‏"},{"verse":16,"text":"وَزَرَابِيُّ مَبۡثُوثَةٌ"},{"verse":17,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ"},{"verse":18,"text":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ"},{"verse":19,"text":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ"},{"verse":20,"text":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ"},{"verse":21,"text":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرࣱ‏"},{"verse":22,"text":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ"},{"verse":23,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"},{"verse":24,"text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ"},{"verse":25,"text":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ"},{"verse":26,"text":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم"}]}