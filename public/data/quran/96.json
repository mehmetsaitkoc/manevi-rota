{"chapter":96,"verses":[{"verse":1,"text":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ"},{"verse":2,"text":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ"},{"verse":3,"text":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ"},{"verse":4,"text":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ"},{"verse":5,"text":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ"},{"verse":6,"text":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ"},{"verse":7,"text":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ"},{"verse":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ"},{"verse":9,"text":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ"},{"verse":10,"text":"عَبۡدًا إِذَا صَلَّىٰٓ"},{"verse":11,"text":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ"},{"verse":12,"text":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ"},{"verse":13,"text":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"},{"verse":14,"text":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ"},{"verse":15,"text":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ"},{"verse":16,"text":"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ‏"},{"verse":17,"text":"فَلۡيَدۡعُ نَادِيَهُۥ"},{"verse":18,"text":"سَنَدۡعُ ٱلزَّبَانِيَةَ"},{"verse":19,"text":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩"}]}