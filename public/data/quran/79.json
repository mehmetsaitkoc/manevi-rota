{"chapter":79,"verses":[{"verse":1,"text":"وَٱلنَّٰزِعَٰتِ غَرۡقࣰ ا"},{"verse":2,"text":"وَٱلنَّٰشِطَٰتِ نَشۡطࣰ ا"},{"verse":3,"text":"وَٱلسَّٰبِحَٰتِ سَبۡحࣰ ا"},{"verse":4,"text":"فَٱلسَّٰبِقَٰتِ سَبۡقࣰ ا"},{"verse":5,"text":"فَٱلۡمُدَبِّرَٰتِ أَمۡرࣰ ا"},{"verse":6,"text":"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ"},{"verse":7,"text":"تَتۡبَعُهَا ٱلرَّادِفَةُ"},{"verse":8,"text":"قُلُوبࣱ يَوۡمَئِذࣲ وَاجِفَةٌ"},{"verse":9,"text":"أَبۡصَٰرُهَا خَٰشِعَةࣱ‏"},{"verse":10,"text":"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ"},{"verse":11,"text":"أَءِذَا كُنَّا عِظَٰمࣰ ا نَّخِرَةࣰ‏"},{"verse":12,"text":"قَالُواْ تِلۡكَ إِذࣰ ا كَرَّةٌ خَاسِرَةࣱ‏"},{"verse":13,"text":"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ‏"},{"verse":14,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ"},{"verse":15,"text":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"},{"verse":16,"text":"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى"},{"verse":17,"text":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ"},{"verse":18,"text":"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ"},{"verse":19,"text":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ"},{"verse":20,"text":"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ"},{"verse":21,"text":"فَكَذَّبَ وَعَصَىٰ"},{"verse":22,"text":"ثُمَّ أَدۡبَرَ يَسۡعَىٰ"},{"verse":23,"text":"فَحَشَرَ فَنَادَىٰ"},{"verse":24,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ"},{"verse":25,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ"},{"verse":26,"text":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةࣰ لِّمَن يَخۡشَىٰٓ"},{"verse":27,"text":"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا"},{"verse":28,"text":"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا"},{"verse":29,"text":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا"},{"verse":30,"text":"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ"},{"verse":31,"text":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا"},{"verse":32,"text":"وَٱلۡجِبَالَ أَرۡسَىٰهَا"},{"verse":33,"text":"مَتَٰعࣰ ا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ"},{"verse":34,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ"},{"verse":35,"text":"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ"},{"verse":36,"text":"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ"},{"verse":37,"text":"فَأَمَّا مَن طَغَىٰ"},{"verse":38,"text":"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا"},{"verse":39,"text":"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ"},{"verse":40,"text":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ"},{"verse":41,"text":"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ"},{"verse":42,"text":"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا"},{"verse":43,"text":"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ"},{"verse":44,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ"},{"verse":45,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا"},{"verse":46,"text":"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا"}]}