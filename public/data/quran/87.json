{"chapter":87,"verses":[{"verse":1,"text":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى"},{"verse":2,"text":"ٱلَّذِي خَلَقَ فَسَوَّىٰ"},{"verse":3,"text":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ"},{"verse":4,"text":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ"},{"verse":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ"},{"verse":6,"text":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ"},{"verse":7,"text":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ"},{"verse":8,"text":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ"},{"verse":9,"text":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ"},{"verse":10,"text":"سَيَذَّكَّرُ مَن يَخۡشَىٰ"},{"verse":11,"text":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى"},{"verse":12,"text":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ"},{"verse":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ"},{"verse":14,"text":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ"},{"verse":15,"text":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ"},{"verse":16,"text":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا"},{"verse":17,"text":"وَٱلۡأٓخِرَةُ خَيۡرࣱ وَأَبۡقَىٰٓ"},{"verse":18,"text":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ"},{"verse":19,"text":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ"}]}