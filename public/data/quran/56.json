{"chapter":56,"verses":[{"verse":1,"text":"إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ"},{"verse":2,"text":"لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ"},{"verse":3,"text":"خَافِضَةࣱ رَّافِعَةٌ"},{"verse":4,"text":"إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجࣰّ ا"},{"verse":5,"text":"وَبُسَّتِ ٱلۡجِبَالُ بَسࣰّ ا"},{"verse":6,"text":"فَكَانَتۡ هَبَآءࣰ مُّنۢبَثࣰّ ا"},{"verse":7,"text":"وَكُنتُمۡ أَزۡوَٰجࣰ ا ثَلَٰثَةࣰ‏"},{"verse":8,"text":"فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ"},{"verse":9,"text":"وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ"},{"verse":10,"text":"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ"},{"verse":11,"text":"أُوْلَٰٓئِكَ ٱلۡمُقَرَّبُونَ"},{"verse":12,"text":"فِي جَنَّٰتِ ٱلنَّعِيمِ"},{"verse":13,"text":"ثُلَّةࣱ مِّنَ ٱلۡأَوَّلِينَ"},{"verse":14,"text":"وَقَلِيلࣱ مِّنَ ٱلۡأٓخِرِينَ"},{"verse":15,"text":"عَلَىٰ سُرُرࣲ مَّوۡضُونَةࣲ‏"},{"verse":16,"text":"مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ"},{"verse":17,"text":"يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنࣱ مُّخَلَّدُونَ"},{"verse":18,"text":"بِأَكۡوَابࣲ وَأَبَارِيقَ وَكَأۡسࣲ مِّن مَّعِينࣲ‏"},{"verse":19,"text":"لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزِفُونَ"},{"verse":20,"text":"وَفَٰكِهَةࣲ مِّمَّا يَتَخَيَّرُونَ"},{"verse":21,"text":"وَلَحۡمِ طَيۡرࣲ مِّمَّا يَشۡتَهُونَ"},{"verse":22,"text":"وَحُورٌ عِينࣱ‏"},{"verse":23,"text":"كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ"},{"verse":24,"text":"جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ"},{"verse":25,"text":"لَا يَسۡمَعُونَ فِيهَا لَغۡوࣰ ا وَلَا تَأۡثِيمًا"},{"verse":26,"text":"إِلَّا قِيلࣰ ا سَلَٰمࣰ ا سَلَٰمࣰ ا"},{"verse":27,"text":"وَأَصۡحَٰبُ ٱلۡيَمِينِ مَآ أَصۡحَٰبُ ٱلۡيَمِينِ"},{"verse":28,"text":"فِي سِدۡرࣲ مَّخۡضُودࣲ‏"},{"verse":29,"text":"وَطَلۡحࣲ مَّنضُودࣲ‏"},{"verse":30,"text":"وَظِلࣲّ مَّمۡدُودࣲ‏"},{"verse":31,"text":"وَمَآءࣲ مَّسۡكُوبࣲ‏"},{"verse":32,"text":"وَفَٰكِهَةࣲ كَثِيرَةࣲ‏"},{"verse":33,"text":"لَّا مَقۡطُوعَةࣲ وَلَا مَمۡنُوعَةࣲ‏"},{"verse":34,"text":"وَفُرُشࣲ مَّرۡفُوعَةٍ"},{"verse":35,"text":"إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءࣰ‏"},{"verse":36,"text":"فَجَعَلۡنَٰهُنَّ أَبۡكَارًا"},{"verse":37,"text":"عُرُبًا أَتۡرَابࣰ ا"},{"verse":38,"text":"لِّأَصۡحَٰبِ ٱلۡيَمِينِ"},{"verse":39,"text":"ثُلَّةࣱ مِّنَ ٱلۡأَوَّلِينَ"},{"verse":40,"text":"وَثُلَّةࣱ مِّنَ ٱلۡأٓخِرِينَ"},{"verse":41,"text":"وَأَصۡحَٰبُ ٱلشِّمَالِ مَآ أَصۡحَٰبُ ٱلشِّمَالِ"},{"verse":42,"text":"فِي سَمُومࣲ وَحَمِيمࣲ‏"},{"verse":43,"text":"وَظِلࣲّ مِّن يَحۡمُومࣲ‏"},{"verse":44,"text":"لَّا بَارِدࣲ وَلَا كَرِيمٍ"},{"verse":45,"text":"إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ"},{"verse":46,"text":"وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ"},{"verse":47,"text":"وَكَانُواْ يَقُولُونَ أَئِذَا مِتۡنَا وَكُنَّا تُرَابࣰ ا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ"},{"verse":48,"text":"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ"},{"verse":49,"text":"قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ"},{"verse":50,"text":"لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمࣲ مَّعۡلُومࣲ‏"},{"verse":51,"text":"ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ"},{"verse":52,"text":"لَأٓكِلُونَ مِن شَجَرࣲ مِّن زَقُّومࣲ‏"},{"verse":53,"text":"فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ"},{"verse":54,"text":"فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ"},{"verse":55,"text":"فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ"},{"verse":56,"text":"هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ"},{"verse":57,"text":"نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ"},{"verse":58,"text":"أَفَرَءَيۡتُم مَّا تُمۡنُونَ"},{"verse":59,"text":"ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ"},{"verse":60,"text":"نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ"},{"verse":61,"text":"عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ"},{"verse":62,"text":"وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ"},{"verse":63,"text":"أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ"},{"verse":64,"text":"ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ"},{"verse":65,"text":"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمࣰ ا فَظَلۡتُمۡ تَفَكَّهُونَ"},{"verse":66,"text":"إِنَّا لَمُغۡرَمُونَ"},{"verse":67,"text":"بَلۡ نَحۡنُ مَحۡرُومُونَ"},{"verse":68,"text":"أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ"},{"verse":69,"text":"ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ"},{"verse":70,"text":"لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجࣰ ا فَلَوۡلَا تَشۡكُرُونَ"},{"verse":71,"text":"أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ"},{"verse":72,"text":"ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ"},{"verse":73,"text":"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةࣰ وَمَتَٰعࣰ ا لِّلۡمُقۡوِينَ"},{"verse":74,"text":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ"},{"verse":75,"text":"۞فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ"},{"verse":76,"text":"وَإِنَّهُۥ لَقَسَمࣱ لَّوۡ تَعۡلَمُونَ عَظِيمٌ"},{"verse":77,"text":"إِنَّهُۥ لَقُرۡءَانࣱ كَرِيمࣱ‏"},{"verse":78,"text":"فِي كِتَٰبࣲ مَّكۡنُونࣲ‏"},{"verse":79,"text":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ"},{"verse":80,"text":"تَنزِيلࣱ مِّن رَّبِّ ٱلۡعَٰلَمِينَ"},{"verse":81,"text":"أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ"},{"verse":82,"text":"وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ"},{"verse":83,"text":"فَلَوۡلَآ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ"},{"verse":84,"text":"وَأَنتُمۡ حِينَئِذࣲ تَنظُرُونَ"},{"verse":85,"text":"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ"},{"verse":86,"text":"فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ"},{"verse":87,"text":"تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ"},{"verse":88,"text":"فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ"},{"verse":89,"text":"فَرَوۡحࣱ وَرَيۡحَانࣱ وَجَنَّتُ نَعِيمࣲ‏"},{"verse":90,"text":"وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ"},{"verse":91,"text":"فَسَلَٰمࣱ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ"},{"verse":92,"text":"وَأَمَّآ إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ"},{"verse":93,"text":"فَنُزُلࣱ مِّنۡ حَمِيمࣲ‏"},{"verse":94,"text":"وَتَصۡلِيَةُ جَحِيمٍ"},{"verse":95,"text":"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ"},{"verse":96,"text":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ"}]}