{"chapter":91,"verses":[{"verse":1,"text":"وَٱلشَّمۡسِ وَضُحَىٰهَا"},{"verse":2,"text":"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا"},{"verse":3,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"},{"verse":4,"text":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا"},{"verse":5,"text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"},{"verse":6,"text":"وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا"},{"verse":7,"text":"وَنَفۡسࣲ وَمَا سَوَّىٰهَا"},{"verse":8,"text":"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا"},{"verse":9,"text":"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا"},{"verse":10,"text":"وَقَدۡ خَابَ مَن دَسَّىٰهَا"},{"verse":11,"text":"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ"},{"verse":12,"text":"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا"},{"verse":13,"text":"فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا"},{"verse":14,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا"},{"verse":15,"text":"وَلَا يَخَافُ عُقۡبَٰهَا"}]}