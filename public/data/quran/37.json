{"chapter":37,"verses":[{"verse":1,"text":"وَٱلصَّٰٓفَّٰتِ صَفࣰّ ا"},{"verse":2,"text":"فَٱلزَّٰجِرَٰتِ زَجۡرࣰ ا"},{"verse":3,"text":"فَٱلتَّٰلِيَٰتِ ذِكۡرًا"},{"verse":4,"text":"إِنَّ إِلَٰهَكُمۡ لَوَٰحِدࣱ‏"},{"verse":5,"text":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ"},{"verse":6,"text":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبِ"},{"verse":7,"text":"وَحِفۡظࣰ ا مِّن كُلِّ شَيۡطَٰنࣲ مَّارِدࣲ‏"},{"verse":8,"text":"لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبࣲ‏"},{"verse":9,"text":"دُحُورࣰ اۖ وَلَهُمۡ عَذَابࣱ وَاصِبٌ"},{"verse":10,"text":"إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابࣱ ثَاقِبࣱ‏"},{"verse":11,"text":"فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينࣲ لَّازِبِۭ"},{"verse":12,"text":"بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ"},{"verse":13,"text":"وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ"},{"verse":14,"text":"وَإِذَا رَأَوۡاْ ءَايَةࣰ يَسۡتَسۡخِرُونَ"},{"verse":15,"text":"وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرࣱ مُّبِينٌ"},{"verse":16,"text":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰ ا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ"},{"verse":17,"text":"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ"},{"verse":18,"text":"قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ"},{"verse":19,"text":"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ فَإِذَا هُمۡ يَنظُرُونَ"},{"verse":20,"text":"وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ"},{"verse":21,"text":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ"},{"verse":22,"text":"۞ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ"},{"verse":23,"text":"مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ"},{"verse":24,"text":"وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ"},{"verse":25,"text":"مَا لَكُمۡ لَا تَنَاصَرُونَ"},{"verse":26,"text":"بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ"},{"verse":27,"text":"وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ يَتَسَآءَلُونَ"},{"verse":28,"text":"قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ"},{"verse":29,"text":"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ"},{"verse":30,"text":"وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمࣰ ا طَٰغِينَ"},{"verse":31,"text":"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ"},{"verse":32,"text":"فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ"},{"verse":33,"text":"فَإِنَّهُمۡ يَوۡمَئِذࣲ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ"},{"verse":34,"text":"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ"},{"verse":35,"text":"إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ"},{"verse":36,"text":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرࣲ مَّجۡنُونِۭ"},{"verse":37,"text":"بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ"},{"verse":38,"text":"إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ"},{"verse":39,"text":"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ"},{"verse":40,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ"},{"verse":41,"text":"أُوْلَٰٓئِكَ لَهُمۡ رِزۡقࣱ مَّعۡلُومࣱ‏"},{"verse":42,"text":"فَوَٰكِهُ وَهُم مُّكۡرَمُونَ"},{"verse":43,"text":"فِي جَنَّٰتِ ٱلنَّعِيمِ"},{"verse":44,"text":"عَلَىٰ سُرُرࣲ مُّتَقَٰبِلِينَ"},{"verse":45,"text":"يُطَافُ عَلَيۡهِم بِكَأۡسࣲ مِّن مَّعِينِۭ"},{"verse":46,"text":"بَيۡضَآءَ لَذَّةࣲ لِّلشَّٰرِبِينَ"},{"verse":47,"text":"لَا فِيهَا غَوۡلࣱ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ"},{"verse":48,"text":"وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينࣱ‏"},{"verse":49,"text":"كَأَنَّهُنَّ بَيۡضࣱ مَّكۡنُونࣱ‏"},{"verse":50,"text":"فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ يَتَسَآءَلُونَ"},{"verse":51,"text":"قَالَ قَآئِلࣱ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينࣱ‏"},{"verse":52,"text":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ"},{"verse":53,"text":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰ ا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ"},{"verse":54,"text":"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ"},{"verse":55,"text":"فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ"},{"verse":56,"text":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ"},{"verse":57,"text":"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ"},{"verse":58,"text":"أَفَمَا نَحۡنُ بِمَيِّتِينَ"},{"verse":59,"text":"إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ"},{"verse":60,"text":"إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ"},{"verse":61,"text":"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ"},{"verse":62,"text":"أَذَٰلِكَ خَيۡرࣱ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ"},{"verse":63,"text":"إِنَّا جَعَلۡنَٰهَا فِتۡنَةࣰ لِّلظَّٰلِمِينَ"},{"verse":64,"text":"إِنَّهَا شَجَرَةࣱ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ"},{"verse":65,"text":"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ"},{"verse":66,"text":"فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ"},{"verse":67,"text":"ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبࣰ ا مِّنۡ حَمِيمࣲ‏"},{"verse":68,"text":"ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ"},{"verse":69,"text":"إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ"},{"verse":70,"text":"فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ"},{"verse":71,"text":"وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ"},{"verse":72,"text":"وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ"},{"verse":73,"text":"فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ"},{"verse":74,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ"},{"verse":75,"text":"وَلَقَدۡ نَادَىٰنَا نُوحࣱ فَلَنِعۡمَ ٱلۡمُجِيبُونَ"},{"verse":76,"text":"وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ"},{"verse":77,"text":"وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ"},{"verse":78,"text":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ"},{"verse":79,"text":"سَلَٰمٌ عَلَىٰ نُوحࣲ فِي ٱلۡعَٰلَمِينَ"},{"verse":80,"text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"},{"verse":81,"text":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ"},{"verse":82,"text":"ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ"},{"verse":83,"text":"۞وَإِنَّ مِن شِيعَتِهِۦ لَإِبۡرَٰهِيمَ"},{"verse":84,"text":"إِذۡ جَآءَ رَبَّهُۥ بِقَلۡبࣲ سَلِيمٍ"},{"verse":85,"text":"إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ"},{"verse":86,"text":"أَئِفۡكًا ءَالِهَةࣰ دُونَ ٱللَّهِ تُرِيدُونَ"},{"verse":87,"text":"فَمَا ظَنُّكُم بِرَبِّ ٱلۡعَٰلَمِينَ"},{"verse":88,"text":"فَنَظَرَ نَظۡرَةࣰ فِي ٱلنُّجُومِ"},{"verse":89,"text":"فَقَالَ إِنِّي سَقِيمࣱ‏"},{"verse":90,"text":"فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ"},{"verse":91,"text":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ"},{"verse":92,"text":"مَا لَكُمۡ لَا تَنطِقُونَ"},{"verse":93,"text":"فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا بِٱلۡيَمِينِ"},{"verse":94,"text":"فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ"},{"verse":95,"text":"قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ"},{"verse":96,"text":"وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ"},{"verse":97,"text":"قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنࣰ ا فَأَلۡقُوهُ فِي ٱلۡجَحِيمِ"},{"verse":98,"text":"فَأَرَادُواْ بِهِۦ كَيۡدࣰ ا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ"},{"verse":99,"text":"وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ"},{"verse":100,"text":"رَبِّ هَبۡ لِي مِنَ ٱلصَّٰلِحِينَ"},{"verse":101,"text":"فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمࣲ‏"},{"verse":102,"text":"فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيَّ إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَٰٓأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ"},{"verse":103,"text":"فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ"},{"verse":104,"text":"وَنَٰدَيۡنَٰهُ أَن يَٰٓإِبۡرَٰهِيمُ"},{"verse":105,"text":"قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"},{"verse":106,"text":"إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَٰٓؤُاْ ٱلۡمُبِينُ"},{"verse":107,"text":"وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمࣲ‏"},{"verse":108,"text":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ"},{"verse":109,"text":"سَلَٰمٌ عَلَىٰٓ إِبۡرَٰهِيمَ"},{"verse":110,"text":"كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"},{"verse":111,"text":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ"},{"verse":112,"text":"وَبَشَّرۡنَٰهُ بِإِسۡحَٰقَ نَبِيࣰّ ا مِّنَ ٱلصَّٰلِحِينَ"},{"verse":113,"text":"وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنࣱ وَظَالِمࣱ لِّنَفۡسِهِۦ مُبِينࣱ‏"},{"verse":114,"text":"وَلَقَد