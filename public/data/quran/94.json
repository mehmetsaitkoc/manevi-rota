{"chapter":94,"verses":[{"verse":1,"text":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ"},{"verse":2,"text":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ"},{"verse":3,"text":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ"},{"verse":4,"text":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ"},{"verse":5,"text":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا"},{"verse":6,"text":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰ ا"},{"verse":7,"text":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ"},{"verse":8,"text":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب"}]}