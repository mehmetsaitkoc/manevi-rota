{"chapter":111,"verses":[{"verse":1,"text":"تَبَّتۡ يَدَآ أَبِي لَهَبࣲ وَتَبَّ"},{"verse":2,"text":"مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ"},{"verse":3,"text":"سَيَصۡلَىٰ نَارࣰ ا ذَاتَ لَهَبࣲ‏"},{"verse":4,"text":"وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ"},{"verse":5,"text":"فِي جِيدِهَا حَبۡلࣱ مِّن مَّسَدِۭ"}]}