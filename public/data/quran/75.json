{"chapter":75,"verses":[{"verse":1,"text":"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ"},{"verse":2,"text":"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ"},{"verse":3,"text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ"},{"verse":4,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ"},{"verse":5,"text":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ"},{"verse":6,"text":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ"},{"verse":7,"text":"فَإِذَا بَرِقَ ٱلۡبَصَرُ"},{"verse":8,"text":"وَخَسَفَ ٱلۡقَمَرُ"},{"verse":9,"text":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ"},{"verse":10,"text":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ"},{"verse":11,"text":"كَلَّا لَا وَزَرَ"},{"verse":12,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ"},{"verse":13,"text":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ"},{"verse":14,"text":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةࣱ‏"},{"verse":15,"text":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ"},{"verse":16,"text":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ"},{"verse":17,"text":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ"},{"verse":18,"text":"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ"},{"verse":19,"text":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ"},{"verse":20,"text":"كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ"},{"verse":21,"text":"وَتَذَرُونَ ٱلۡأٓخِرَةَ"},{"verse":22,"text":"وُجُوهࣱ يَوۡمَئِذࣲ نَّاضِرَةٌ"},{"verse":23,"text":"إِلَىٰ رَبِّهَا نَاظِرَةࣱ‏"},{"verse":24,"text":"وَوُجُوهࣱ يَوۡمَئِذِۭ بَاسِرَةࣱ‏"},{"verse":25,"text":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةࣱ‏"},{"verse":26,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ"},{"verse":27,"text":"وَقِيلَ مَنۡۜ رَاقࣲ‏"},{"verse":28,"text":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ"},{"verse":29,"text":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"},{"verse":30,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ"},{"verse":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"},{"verse":32,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ"},{"verse":33,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ"},{"verse":34,"text":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ"},{"verse":35,"text":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ"},{"verse":36,"text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى"},{"verse":37,"text":"أَلَمۡ يَكُ نُطۡفَةࣰ مِّن مَّنِيࣲّ يُمۡنَىٰ"},{"verse":38,"text":"ثُمَّ كَانَ عَلَقَةࣰ فَخَلَقَ فَسَوَّىٰ"},{"verse":39,"text":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ"},{"verse":40,"text":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ"}]}