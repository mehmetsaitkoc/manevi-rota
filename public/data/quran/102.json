{"chapter":102,"verses":[{"verse":1,"text":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ"},{"verse":2,"text":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ"},{"verse":3,"text":"كَلَّا سَوۡفَ تَعۡلَمُونَ"},{"verse":4,"text":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ"},{"verse":5,"text":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ"},{"verse":6,"text":"لَتَرَوُنَّ ٱلۡجَحِيمَ"},{"verse":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ"},{"verse":8,"text":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ"}]}