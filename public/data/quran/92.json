{"chapter":92,"verses":[{"verse":1,"text":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ"},{"verse":2,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"},{"verse":3,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ"},{"verse":4,"text":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ"},{"verse":5,"text":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ"},{"verse":6,"text":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ"},{"verse":7,"text":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ"},{"verse":8,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ"},{"verse":9,"text":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ"},{"verse":10,"text":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ"},{"verse":11,"text":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"},{"verse":12,"text":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ"},{"verse":13,"text":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ"},{"verse":14,"text":"فَأَنذَرۡتُكُمۡ نَارࣰ ا تَلَظَّىٰ"},{"verse":15,"text":"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى"},{"verse":16,"text":"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ"},{"verse":17,"text":"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى"},{"verse":18,"text":"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ"},{"verse":19,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزَىٰٓ"},{"verse":20,"text":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ"},{"verse":21,"text":"وَلَسَوۡفَ يَرۡضَىٰ"}]}