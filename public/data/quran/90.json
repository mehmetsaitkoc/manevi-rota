{"chapter":90,"verses":[{"verse":1,"text":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ"},{"verse":2,"text":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ"},{"verse":3,"text":"وَوَالِدࣲ وَمَا وَلَدَ"},{"verse":4,"text":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ"},{"verse":5,"text":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدࣱ‏"},{"verse":6,"text":"يَقُولُ أَهۡلَكۡتُ مَالࣰ ا لُّبَدًا"},{"verse":7,"text":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ"},{"verse":8,"text":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ"},{"verse":9,"text":"وَلِسَانࣰ ا وَشَفَتَيۡنِ"},{"verse":10,"text":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ"},{"verse":11,"text":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ"},{"verse":12,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ"},{"verse":13,"text":"فَكُّ رَقَبَةٍ"},{"verse":14,"text":"أَوۡ إِطۡعَٰمࣱ فِي يَوۡمࣲ ذِي مَسۡغَبَةࣲ‏"},{"verse":15,"text":"يَتِيمࣰ ا ذَا مَقۡرَبَةٍ"},{"verse":16,"text":"أَوۡ مِسۡكِينࣰ ا ذَا مَتۡرَبَةࣲ‏"},{"verse":17,"text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ"},{"verse":18,"text":"أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ"},{"verse":19,"text":"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ"},{"verse":20,"text":"عَلَيۡهِمۡ نَارࣱ مُّؤۡصَدَةُۢ"}]}